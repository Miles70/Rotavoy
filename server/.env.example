PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rotavoy?retryWrites=true&w=majority
CLIENT_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NODE_ENV=development

# Customer account authentication
FIREBASE_PROJECT_ID=rotavoy
CUSTOMER_AUTH_APP_NAME=Rotavoy

# Order stock reservation
ORDER_PAYMENT_TTL_MINUTES=30
ORDER_RESERVATION_SWEEP_MS=60000

# Crypto payments (BNB Smart Chain / Binance-Peg USDT)
ROTAVOY_PAYMENT_WALLET=0xYOUR_RECEIVING_WALLET_ADDRESS
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_USDT_DECIMALS=18
BSC_MIN_CONFIRMATIONS=1

# CJdropshipping fulfillment
# Create an API Key in CJ > Apps > API, then keep it server-side only.
CJ_API_KEY=
CJ_SANDBOX=true
CJ_FROM_COUNTRY_CODE=CN
CJ_PRICE_MARKUP=1.65
CJ_SYNC_KEYWORDS=travel,electronics,home,beauty,sports
CJ_SYNC_PRODUCTS_PER_KEYWORD=6
CJ_REPLACE_LEGACY_CATALOG=true
# Refresh every stored CJ product after startup and then every 6 hours.
# Removed variants and zero-stock products are hidden from the storefront.
CJ_AVAILABILITY_SYNC_INITIAL_DELAY_MS=15000
CJ_AVAILABILITY_SYNC_INTERVAL_MS=21600000

# Optional large-catalog bootstrap. `npm run cj:bootstrap` uses these values,
# skips already stored CJ parent products, batches work, and can be run again
# after an interruption to continue filling the catalog toward the target.
CJ_BOOTSTRAP_TARGET_PRODUCTS=500
CJ_BOOTSTRAP_PRIORITY_KEYWORDS=phone stand,charging cable,cable organizer,desk organizer,home storage organizer,kitchen organizer,food storage container,cleaning brush,microfiber cleaning cloth,laundry organizer,pet grooming tool,interactive pet toy,travel organizer,packing cubes,car seat organizer,car cleaning tool,resistance bands,yoga accessories,hair accessories,makeup organizer,baby safety product,household hand tools,gardening hand tools,reusable shopping bag,water bottle
CJ_BOOTSTRAP_PRODUCTS_PER_KEYWORD=30
CJ_BOOTSTRAP_PAGE_SIZE=100
CJ_BOOTSTRAP_MAX_PAGES_PER_KEYWORD=20
CJ_BOOTSTRAP_BATCH_SIZE=100
CJ_BOOTSTRAP_VARIANTS_PER_PRODUCT=12

# Product localization
# The legacy Google translator is disabled. CJ sync stores the untouched English
# source; Luna creates and caches polished content for all 10 Rotavoy languages.
CJ_TRANSLATE_PRODUCTS=false
# Number of CJ parent products handled per resumable Luna enrichment run.
PRODUCT_TRANSLATION_BACKFILL_LIMIT=20

# Professional Rotavoy catalog copy (backend only)
# One AI request enriches one supplier product and all of its active variants,
# then caches polished copy for all Rotavoy languages in MongoDB.
OPENAI_API_KEY=
ROTAVOY_AI_CONTENT_ENABLED=true
ROTAVOY_CONTENT_MODEL=gpt-5.6-luna
ROTAVOY_CONTENT_BATCH_SIZE=20
ROTAVOY_CONTENT_REQUEST_INTERVAL_MS=750
ROTAVOY_CONTENT_TIMEOUT_MS=60000
# After each regular CJ sync, let Luna enrich the pending product batch.
ROTAVOY_CONTENT_ENRICH_ON_SYNC=true

# Nuitee Connect / LiteAPI hotel inventory (server-side only)
# Use the sand_ key from Nuitee Connect > Developer tools > API Keys.
NUITEE_API_KEY=
NUITEE_API_TIMEOUT_MS=15000
# Rotavoy markup added to Nuitee net rates.
NUITEE_DEFAULT_MARGIN_PERCENT=15
# Safety lock: leave false until intentionally testing a sandbox reservation.
NUITEE_ENABLE_SANDBOX_BOOKING=false
