PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/rotavoy?retryWrites=true&w=majority
CLIENT_ORIGINS=http://localhost:5173
NODE_ENV=development

# Customer authentication
FIREBASE_PROJECT_ID=rotavoy
CUSTOMER_AUTH_APP_NAME=Rotavoy

# Travel crypto payments
# One EVM receiving wallet is used for BNB Smart Chain and Ethereum.
ROTAVOY_PAYMENT_WALLET=0x7Cd14DD705F5e05D8B1B9853245Cc60Bd8251Ff4
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_USDT_CONTRACT=0x55d398326f99059ff775485246999027b3197955
BSC_USDT_DECIMALS=18
BSC_USDC_CONTRACT=0x8ac76a51cc950d9822d68b83fe1ad97b32cd580d
BSC_USDC_DECIMALS=18
BSC_MIN_CONFIRMATIONS=1
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_MIN_CONFIRMATIONS=1
# Optional override for BNB/ETH USD quotes.
CRYPTO_PRICE_API_URL=https://api.binance.com/api/v3/ticker/price

# Nuitee Connect / LiteAPI hotel inventory
NUITEE_API_KEY=
NUITEE_API_TIMEOUT_MS=15000
NUITEE_DEFAULT_MARGIN_PERCENT=15
NUITEE_STRIPE_PUBLISHABLE_KEY=
NUITEE_ENABLE_SANDBOX_BOOKING=false
NUITEE_ENABLE_LIVE_BOOKING=false

# Hotel descriptions are translated and cached in MongoDB.
OPENAI_API_KEY=
ROTAVOY_HOTEL_TRANSLATION_MODEL=gpt-5.6-luna
