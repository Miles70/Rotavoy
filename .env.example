# Leave empty during local development to use the Vite /api proxy.
# Set this to the deployed backend URL in production, without a trailing slash.
VITE_API_BASE_URL=

# Required for Web3 wallet connections.
# Create or manage the project in the Reown Dashboard.
VITE_REOWN_PROJECT_ID=

# Address shown on the contact and support pages.
VITE_SUPPORT_EMAIL=support@rotavoy.com

# Set staging ONLY on a separate test deployment to retain test cards/UI.
# Public production builds default to production. Local Vite dev keeps test UI.
VITE_ROTAVOY_ENV=production
