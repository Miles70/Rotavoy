{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": "vite",
 "buildCommand": "npm run build",
 "outputDirectory": "dist",
 "cleanUrls": true,
 "trailingSlash": false,
 "functions": { "api/page.js": { "includeFiles": "dist/{index.html,seo-manifest.json}" } },
 "headers": [
  { "source": "/(.*)", "has": [{ "type": "query", "key": "checkin" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
  { "source": "/(.*)", "has": [{ "type": "query", "key": "departure" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
 ],
 "rewrites": [{ "source": "/:path*", "destination": "/api/page?path=:path*" }]
}
